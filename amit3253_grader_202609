#!/usr/bin/env python3
"""
AMIT3253 Cloud Computing for Business - Automated Grading Script
Final Assessment (December, Week 6) - AWS Academy Learner Lab
 
Grades a student's deployed AWS resources against the four exam questions:
  Question 1 - VPC and Networking        (25 marks)
  Question 2 - EC2 Instance               (25 marks)
  Question 3 - Application Load Balancer  (25 marks)
  Question 4 - Auto Scaling Group         (25 marks)
  TOTAL                                   (100 marks)
 
This script is a first-pass grader only. Per the marking rubric
(AMIT3253_Marking_Rubric.md), if the auto-grader's output disagrees with the
student's submitted screenshot evidence, the rubric is the reference for
manual adjustment - run this script first, then reconcile any discrepancy
by hand using the rubric.
 
Run inside the student's AWS Academy Learner Lab session (same region the
resources were created in), with boto3 credentials already configured
(the Learner Lab's exported AWS CLI credentials are sufficient).
"""
 
import base64
import re
 
import boto3
 
TOTAL_MARKS = 0
SCORED_MARKS = 0
QUESTION_SUBTOTALS = []  # (label, scored, total) per question

# What each criterion expects, printed next to its score so students can check
# their own setup. What the grader actually found is not shown.
REQUIREMENTS = {
    "1.1": "vpc-<yourname>",
    "1.2": "CIDR 10.0.0.0/16",
    "1.3": "subnets in 3 AZs",
    "1.4": "10.0.1.0/24, 10.0.2.0/24, 10.0.3.0/24",
    "1.5": "10.0.11.0/24, 10.0.12.0/24, 10.0.13.0/24",
    "1.6": "created and attached to the VPC",
    "1.7": "0.0.0.0/0 routed to the VPC's IGW",
    "1.8": "associated with all 3 public subnets",
    "2.1": "ec2-<yourname>",
    "2.2": "Amazon Linux 2023",
    "2.3": "t3.large",
    "2.4": "Q1 VPC, public subnet",
    "2.5": "public IP assigned",
    "2.6": "<yourname>-sg-ec2",
    "2.7": "inbound HTTP, SSH, MySQL",
    "2.8": "15 GiB gp2",
    "2.9": "LabInstanceProfile",
    "2.10": "installs and runs httpd, personalised page",
    "3.1": "tg-<yourname>",
    "3.2": "instance",
    "3.3": "HTTP, port 80",
    "3.4": "Q1 VPC",
    "3.5": "HTTP, path /",
    "3.6": "alb-<yourname>",
    "3.7": "Application, internet-facing, IPv4",
    "3.8": "2 AZs, Q1 public subnets",
    "3.9": "<yourname>-sg-alb, inbound HTTP",
    "3.10": "HTTP, port 80",
    "3.11": "forwards to the Q3 target group",
    "4.1": "lt-<yourname>",
    "4.2": "same AMI, instance type and user data as Q2",
    "4.3": "asg-<yourname>",
    "4.4": "Q1 VPC",
    "4.5": "2 public subnets in different AZs",
    "4.6": "<yourname>-sg-asg, port 80 from the ALB SG",
    "4.7": "Min 1, Desired 1, Max 3",
    "4.8": "the Q3 target group",
    "4.9": "CPU target tracking, target 70%",
    "4.10": "ASG instance healthy in the Q3 target group",
}
 
 
def print_header(text):
    print("\n" + "=" * 70)
    print(text)
    print("=" * 70)
 
 
def normalize_name(s):
    """Lowercase and strip everything except letters/digits, so spacing,
    hyphens, underscores and case differences never block a match."""
    if not s:
        return ""
    return re.sub(r'[^a-z0-9]', '', s.lower())
 
 
def has_token(name, token):
    """True if the normalized token appears inside the normalized name."""
    if not name or not token:
        return False
    return normalize_name(token) in normalize_name(name)
 
 
def get_name_tag(tags):
    """Pull the 'Name' tag value out of a boto3 Tags list."""
    if not tags:
        return ""
    for tag in tags:
        if tag.get('Key') == 'Name':
            return tag.get('Value', "")
    return ""
 
 
def award_points(description, max_points, points_earned, details=""):
    """Record a scored criterion. points_earned is clamped to [0, max_points]."""
    global TOTAL_MARKS, SCORED_MARKS
    TOTAL_MARKS += max_points
    points_earned = max(0, min(points_earned, max_points))
    SCORED_MARKS += points_earned
    if points_earned == max_points:
        mark = "[OK]"
    elif points_earned > 0:
        mark = "[~]"
    else:
        mark = "[X]"
    # `details` (what was found) is deliberately not printed; callers keep
    # passing it so it is easy to print again when debugging the grader.
    requirement = REQUIREMENTS.get(description.split()[0], "")
    suffix = f"  Requires: {requirement}" if requirement else ""
    score = f"{points_earned}/{max_points}"
    print(f"{mark:<4} {description + ':':<29} {score:>5}{suffix}")
    return points_earned
 
 
def print_subtotal(label, start):
    """Print and record the marks scored since `start` (a (scored, total) snapshot)."""
    scored = SCORED_MARKS - start[0]
    total = TOTAL_MARKS - start[1]
    print("-" * 70)
    print(f"{label} SUBTOTAL: {scored} / {total}")
    QUESTION_SUBTOTALS.append((label, scored, total))


def main():
    global TOTAL_MARKS, SCORED_MARKS
 
    print_header("AMIT3253 CLOUD COMPUTING - AUTO GRADER (V8 - PARTIAL MARKS)")
 
    student_name = input("Enter Student Full Name: ").strip()
    name_token = student_name  # has_token()/normalize_name() absorb spacing/case/hyphen differences
 
    ec2 = boto3.client('ec2')
    asg_client = boto3.client('autoscaling')
    elbv2 = boto3.client('elbv2')
 
    # Values captured in Question 1/2/3 and reused by later questions.
    target_vpc = None
    public_subnets = []
    q2_ami_id = None
    q2_instance_type = None
    q2_userdata = ""
    target_tg = None
    target_alb = None
    alb_sg = None
 
    # ================================================================
    # QUESTION 1: VPC AND NETWORKING (25 marks)
    # ================================================================
    print_header("QUESTION 1: VPC AND NETWORKING (25 marks)")
    q1_start = (SCORED_MARKS, TOTAL_MARKS)
 
    igw = None
 
    try:
        vpcs = ec2.describe_vpcs()['Vpcs']
        candidates = [v for v in vpcs if has_token(get_name_tag(v.get('Tags')), name_token)
                      or has_token(get_name_tag(v.get('Tags')), 'vpc')]
        for v in candidates:
            if has_token(get_name_tag(v.get('Tags')), name_token):
                target_vpc = v
                break
        if not target_vpc and candidates:
            target_vpc = candidates[0]
 
        # 1.1 VPC Name (4m) - accept vpc-<name> or vpc-<name>-vpc (wizard auto-suffix)
        vpc_name = get_name_tag(target_vpc.get('Tags')) if target_vpc else ""
        name_ok = bool(target_vpc) and has_token(vpc_name, 'vpc') and has_token(vpc_name, name_token)
        award_points("1.1 VPC Name", 4, 4 if name_ok else 0, vpc_name or "not found")
 
        # 1.2 VPC CIDR Block (3m)
        cidr_ok = bool(target_vpc) and target_vpc.get('CidrBlock') == '10.0.0.0/16'
        award_points("1.2 VPC CIDR Block", 3, 3 if cidr_ok else 0,
                      target_vpc.get('CidrBlock') if target_vpc else "no VPC found")
 
        if target_vpc:
            vpc_id = target_vpc['VpcId']
            subnets = ec2.describe_subnets(Filters=[{'Name': 'vpc-id', 'Values': [vpc_id]}])['Subnets']
            existing_cidrs = [s['CidrBlock'] for s in subnets]
            azs_used = set(s['AvailabilityZone'] for s in subnets)
 
            # 1.3 Availability Zones (4m for 3+, 2m for exactly 2, 0m for 1 or none)
            if len(azs_used) >= 3:
                az_points = 4
            elif len(azs_used) == 2:
                az_points = 2
            else:
                az_points = 0
            award_points("1.3 Availability Zones", 4, az_points, f"{len(azs_used)} AZ(s) used")
 
            # 1.4 Public Subnets (1m each for required CIDRs)
            public_cidrs_required = ['10.0.1.0/24', '10.0.2.0/24', '10.0.3.0/24']
            pub_points = sum(1 for c in public_cidrs_required if c in existing_cidrs)
            award_points("1.4 Public Subnets", 3, pub_points, f"found {pub_points}/3 required CIDRs")
 
            # 1.5 Private Subnets (1m each for required CIDRs)
            private_cidrs_required = ['10.0.11.0/24', '10.0.12.0/24', '10.0.13.0/24']
            priv_points = sum(1 for c in private_cidrs_required if c in existing_cidrs)
            award_points("1.5 Private Subnets", 3, priv_points, f"found {priv_points}/3 required CIDRs")
 
            public_subnets = [s for s in subnets if s['CidrBlock'] in public_cidrs_required]
 
            # 1.6 Internet Gateway (1m created, 1m attached to this VPC)
            all_igws = ec2.describe_internet_gateways()['InternetGateways']
            attached_igws = ec2.describe_internet_gateways(
                Filters=[{'Name': 'attachment.vpc-id', 'Values': [vpc_id]}]
            )['InternetGateways']
            igw_created = len(all_igws) > 0
            igw_attached = len(attached_igws) > 0
            if igw_attached:
                igw = attached_igws[0]
            igw_points = (1 if igw_created else 0) + (1 if igw_attached else 0)
            award_points("1.6 Internet Gateway", 2, igw_points,
                         f"created={igw_created}, attached={igw_attached}")
 
            # 1.7 Public Route Table (1m route exists, 1m dest 0.0.0.0/0, 1m target = correct IGW)
            rtbs = ec2.describe_route_tables(Filters=[{'Name': 'vpc-id', 'Values': [vpc_id]}])['RouteTables']
            route_exists = dest_correct = target_correct = False
            public_rtb = None
            for rtb in rtbs:
                for route in rtb.get('Routes', []):
                    if str(route.get('GatewayId', '')).startswith('igw-'):
                        route_exists = True
                        if route.get('DestinationCidrBlock') == '0.0.0.0/0':
                            dest_correct = True
                        if igw and route.get('GatewayId') == igw['InternetGatewayId']:
                            target_correct = True
                        public_rtb = rtb
            rtb_points = (1 if route_exists else 0) + (1 if dest_correct else 0) + (1 if target_correct else 0)
            award_points("1.7 Public Route Table", 3, rtb_points,
                         f"route={route_exists}, dest={dest_correct}, target={target_correct}")
 
            # 1.8 Route Table Association (1m per public subnet associated, up to 3)
            assoc_count = 0
            if public_rtb:
                associated_subnet_ids = [a.get('SubnetId') for a in public_rtb.get('Associations', [])
                                          if a.get('SubnetId')]
                assoc_count = sum(1 for ps in public_subnets if ps['SubnetId'] in associated_subnet_ids)
            award_points("1.8 Route Table Association", 3, min(assoc_count, 3),
                         f"{min(assoc_count, 3)}/3 public subnets associated")
        else:
            award_points("1.3 Availability Zones", 4, 0)
            award_points("1.4 Public Subnets", 3, 0)
            award_points("1.5 Private Subnets", 3, 0)
            award_points("1.6 Internet Gateway", 2, 0)
            award_points("1.7 Public Route Table", 3, 0)
            award_points("1.8 Route Table Association", 3, 0)
 
    except Exception as e:
        print("Error grading Question 1 - ask your marker to check.")

    print_subtotal("QUESTION 1", q1_start)
 
    # ================================================================
    # QUESTION 2: EC2 INSTANCE (25 marks)
    # ================================================================
    print_header("QUESTION 2: EC2 INSTANCE (25 marks)")
    q2_start = (SCORED_MARKS, TOTAL_MARKS)
 
    target_instance = None
 
    try:
        reservations = ec2.describe_instances(
            Filters=[{'Name': 'instance-state-name', 'Values': ['running', 'pending', 'stopped']}]
        )['Reservations']
        all_instances = [i for r in reservations for i in r['Instances']]
 
        # Exclude ASG-managed instances so Q2 grades the standalone instance, not a Q4 one.
        standalone_instances = [
            i for i in all_instances
            if not any(t.get('Key') == 'aws:autoscaling:groupName' for t in i.get('Tags', []))
        ]
 
        candidates = [i for i in standalone_instances if has_token(get_name_tag(i.get('Tags')), name_token)]
        if not candidates:
            candidates = standalone_instances
        if candidates:
            running = [i for i in candidates if i['State']['Name'] == 'running']
            target_instance = running[0] if running else candidates[0]
 
        inst_name = get_name_tag(target_instance.get('Tags')) if target_instance else ""
 
        # 2.1 Instance Name (3m)
        name_ok = bool(target_instance) and has_token(inst_name, 'ec2') and has_token(inst_name, name_token)
        award_points("2.1 Instance Name", 3, 3 if name_ok else 0, inst_name or "not found")
 
        # 2.2 AMI (3m) - Amazon Linux 2023
        ami_ok = False
        ami_desc = "no instance found"
        if target_instance:
            q2_ami_id = target_instance['ImageId']
            ami_desc = q2_ami_id
            try:
                images = ec2.describe_images(ImageIds=[q2_ami_id])['Images']
                if images:
                    ami_name = images[0].get('Name', '')
                    ami_desc = ami_name
                    if 'al2023' in normalize_name(ami_name):
                        ami_ok = True
            except Exception:
                pass
        award_points("2.2 AMI", 3, 3 if ami_ok else 0, ami_desc)
 
        # 2.3 Instance Type (3m) - t3.large
        if target_instance:
            q2_instance_type = target_instance['InstanceType']
        type_ok = q2_instance_type == 't3.large'
        award_points("2.3 Instance Type", 3, 3 if type_ok else 0, q2_instance_type or "not found")
 
        # 2.4 VPC/Subnet Placement (1m correct VPC, 1m public subnet from Q1)
        vpc_match = subnet_match = False
        if target_instance and target_vpc:
            vpc_match = target_instance.get('VpcId') == target_vpc['VpcId']
            public_subnet_ids = [s['SubnetId'] for s in public_subnets]
            subnet_match = target_instance.get('SubnetId') in public_subnet_ids
        award_points("2.4 VPC/Subnet Placement", 2, (1 if vpc_match else 0) + (1 if subnet_match else 0),
                     f"vpc_match={vpc_match}, public_subnet={subnet_match}")
 
        # 2.5 Public IP Auto-assign (1m)
        public_ip_ok = bool(target_instance) and bool(target_instance.get('PublicIpAddress'))
        award_points("2.5 Public IP Auto-assign", 1, 1 if public_ip_ok else 0)
 
        # Resolve the EC2 security group for 2.6/2.7
        ec2_sg = None
        if target_instance:
            sg_refs = target_instance.get('SecurityGroups', [])
            if sg_refs:
                sg_details = ec2.describe_security_groups(
                    GroupIds=[sg['GroupId'] for sg in sg_refs]
                )['SecurityGroups']
                for sg in sg_details:
                    if has_token(sg.get('GroupName', ''), name_token) and has_token(sg.get('GroupName', ''), 'sg'):
                        ec2_sg = sg
                        break
                if not ec2_sg and sg_details:
                    ec2_sg = sg_details[0]
 
        # 2.6 Security Group Name (1m) - <name>-sg-ec2
        sg_name_ok = bool(ec2_sg) and has_token(ec2_sg.get('GroupName', ''), name_token) \
                    and has_token(ec2_sg.get('GroupName', ''), 'sg') and has_token(ec2_sg.get('GroupName', ''), 'ec2')
        award_points("2.6 Security Group Name", 1, 1 if sg_name_ok else 0,
                     ec2_sg.get('GroupName') if ec2_sg else "not found")
 
        # 2.7 Security Group Rules (1m HTTP, 1m SSH, 1m MySQL)
        http_ok = ssh_ok = mysql_ok = False
        if ec2_sg:
            for perm in ec2_sg.get('IpPermissions', []):
                from_port, to_port = perm.get('FromPort'), perm.get('ToPort')
                if from_port is not None and to_port is not None:
                    if from_port <= 80 <= to_port:
                        http_ok = True
                    if from_port <= 22 <= to_port:
                        ssh_ok = True
                    if from_port <= 3306 <= to_port:
                        mysql_ok = True
        award_points("2.7 Security Group Rules", 3,
                     (1 if http_ok else 0) + (1 if ssh_ok else 0) + (1 if mysql_ok else 0),
                     f"HTTP={http_ok}, SSH={ssh_ok}, MySQL={mysql_ok}")
 
        # 2.8 Root Volume (1m) - 15 GiB gp2
        vol_ok = False
        vol_desc = "not found"
        if target_instance:
            root_device = target_instance.get('RootDeviceName')
            for bdm in target_instance.get('BlockDeviceMappings', []):
                if bdm.get('DeviceName') == root_device and 'Ebs' in bdm:
                    try:
                        vols = ec2.describe_volumes(VolumeIds=[bdm['Ebs']['VolumeId']])['Volumes']
                        if vols:
                            v = vols[0]
                            vol_desc = f"{v['Size']}GiB {v['VolumeType']}"
                            if v['Size'] == 15 and v['VolumeType'] == 'gp2':
                                vol_ok = True
                    except Exception:
                        pass
        award_points("2.8 Root Volume", 1, 1 if vol_ok else 0, vol_desc)
 
        # 2.9 IAM Instance Profile (1m attached, 3m specifically the Learner Lab profile)
        # AWS Academy's profile is LabInstanceProfile, which wraps the LabRole role.
        profile_attached = bool(target_instance) and bool(target_instance.get('IamInstanceProfile'))
        profile_is_lab_role = False
        profile_arn = ""
        if profile_attached:
            profile_arn = target_instance['IamInstanceProfile'].get('Arn', '')
            profile_is_lab_role = 'labinstanceprofile' in normalize_name(profile_arn)
        award_points("2.9 IAM Instance Profile", 4,
                     (1 if profile_attached else 0) + (3 if profile_is_lab_role else 0),
                     profile_arn or "not attached")
 
        # 2.10 User Data Script (1m httpd installed, 1m httpd running/enabled, 2m personalised content)
        httpd_installed = httpd_running = personalised = False
        if target_instance:
            try:
                attr = ec2.describe_instance_attribute(
                    InstanceId=target_instance['InstanceId'], Attribute='userData'
                )
                ud_value = attr.get('UserData', {}).get('Value')
                if ud_value:
                    q2_userdata = base64.b64decode(ud_value).decode('utf-8', errors='ignore')
                    ud_lower = q2_userdata.lower()
                    if 'httpd' in ud_lower and 'install' in ud_lower:
                        httpd_installed = True
                    if 'httpd' in ud_lower and 'systemctl' in ud_lower and \
                       ('start' in ud_lower or 'enable' in ud_lower):
                        httpd_running = True
                    if has_token(q2_userdata, name_token):
                        personalised = True
            except Exception:
                pass
        award_points("2.10 User Data Script", 4,
                     (1 if httpd_installed else 0) + (1 if httpd_running else 0) + (2 if personalised else 0),
                     f"installed={httpd_installed}, running={httpd_running}, personalised={personalised}")
 
    except Exception as e:
        print("Error grading Question 2 - ask your marker to check.")

    print_subtotal("QUESTION 2", q2_start)
 
    # ================================================================
    # QUESTION 3: APPLICATION LOAD BALANCER (25 marks)
    # ================================================================
    print_header("QUESTION 3: APPLICATION LOAD BALANCER (25 marks)")
    q3_start = (SCORED_MARKS, TOTAL_MARKS)
 
    try:
        tgs = elbv2.describe_target_groups()['TargetGroups']
        tg_candidates = [tg for tg in tgs if has_token(tg.get('TargetGroupName', ''), name_token)]
        if tg_candidates:
            target_tg = tg_candidates[0]
        tg_name = target_tg.get('TargetGroupName', '') if target_tg else ""
 
        # 3.1 Target Group Name (3m)
        tg_name_ok = bool(target_tg) and has_token(tg_name, 'tg') and has_token(tg_name, name_token)
        award_points("3.1 Target Group Name", 3, 3 if tg_name_ok else 0, tg_name or "not found")
 
        # 3.2 Target Type (3m) - Instances
        type_ok = bool(target_tg) and target_tg.get('TargetType') == 'instance'
        award_points("3.2 Target Type", 3, 3 if type_ok else 0,
                     target_tg.get('TargetType') if target_tg else "not found")
 
        # 3.3 TG Protocol/Port (1m HTTP, 1m port 80)
        proto_ok = bool(target_tg) and target_tg.get('Protocol') == 'HTTP'
        port_ok = bool(target_tg) and target_tg.get('Port') == 80
        award_points("3.3 TG Protocol/Port", 2, (1 if proto_ok else 0) + (1 if port_ok else 0))
 
        # 3.4 TG VPC (1m) - VPC from Q1
        tg_vpc_ok = bool(target_tg) and bool(target_vpc) and target_tg.get('VpcId') == target_vpc['VpcId']
        award_points("3.4 TG VPC", 1, 1 if tg_vpc_ok else 0)
 
        # 3.5 Health Check (1m HTTP, 1m path /)
        hc_proto_ok = bool(target_tg) and target_tg.get('HealthCheckProtocol') == 'HTTP'
        hc_path_ok = bool(target_tg) and target_tg.get('HealthCheckPath') == '/'
        award_points("3.5 Health Check", 2, (1 if hc_proto_ok else 0) + (1 if hc_path_ok else 0))
 
        albs = elbv2.describe_load_balancers()['LoadBalancers']
        alb_candidates = [a for a in albs if has_token(a.get('LoadBalancerName', ''), name_token)]
        if alb_candidates:
            target_alb = alb_candidates[0]
        alb_name = target_alb.get('LoadBalancerName', '') if target_alb else ""
 
        # 3.6 Load Balancer Name (3m)
        alb_name_ok = bool(target_alb) and has_token(alb_name, 'alb') and has_token(alb_name, name_token)
        award_points("3.6 Load Balancer Name", 3, 3 if alb_name_ok else 0, alb_name or "not found")
 
        # 3.7 ALB Type/Scheme/IP (1m ALB + internet-facing, 1m IPv4)
        type_scheme_ok = bool(target_alb) and target_alb.get('Type') == 'application' \
                         and target_alb.get('Scheme') == 'internet-facing'
        ip_ok = bool(target_alb) and target_alb.get('IpAddressType') == 'ipv4'
        award_points("3.7 ALB Type/Scheme/IP", 2, (1 if type_scheme_ok else 0) + (1 if ip_ok else 0))
 
        # 3.8 Availability Zones (1m per AZ with a Q1 public subnet selected, up to 2)
        az_points = 0
        if target_alb:
            alb_azs = target_alb.get('AvailabilityZones', [])
            public_subnet_ids = [s['SubnetId'] for s in public_subnets]
            az_points = min(sum(1 for az in alb_azs if az.get('SubnetId') in public_subnet_ids), 2)
        award_points("3.8 Availability Zones", 2, az_points, f"{az_points}/2 AZs with a public subnet")
 
        # Resolve the ALB security group for 3.9 (and reuse for Q4's source check)
        if target_alb and target_alb.get('SecurityGroups'):
            sg_details = ec2.describe_security_groups(GroupIds=target_alb['SecurityGroups'])['SecurityGroups']
            for sg in sg_details:
                if has_token(sg.get('GroupName', ''), name_token) and has_token(sg.get('GroupName', ''), 'alb'):
                    alb_sg = sg
                    break
            if not alb_sg and sg_details:
                alb_sg = sg_details[0]
 
        # 3.9 ALB Security Group (1m named correctly, 1m correct HTTP inbound rule)
        alb_sg_name_ok = bool(alb_sg) and has_token(alb_sg.get('GroupName', ''), name_token) \
                        and has_token(alb_sg.get('GroupName', ''), 'sg') and has_token(alb_sg.get('GroupName', ''), 'alb')
        alb_sg_rule_ok = False
        if alb_sg:
            for perm in alb_sg.get('IpPermissions', []):
                from_port, to_port = perm.get('FromPort'), perm.get('ToPort')
                if from_port is not None and to_port is not None and from_port <= 80 <= to_port:
                    alb_sg_rule_ok = True
        award_points("3.9 ALB Security Group", 2, (1 if alb_sg_name_ok else 0) + (1 if alb_sg_rule_ok else 0),
                     alb_sg.get('GroupName') if alb_sg else "not found")
 
        # Listener / default action
        listener_proto_ok = listener_port_ok = False
        action_exists = action_forwards_correctly = False
        if target_alb:
            listeners = elbv2.describe_listeners(LoadBalancerArn=target_alb['LoadBalancerArn'])['Listeners']
            if listeners:
                listener = listeners[0]
                listener_proto_ok = listener.get('Protocol') == 'HTTP'
                listener_port_ok = listener.get('Port') == 80
                for action in listener.get('DefaultActions', []):
                    action_exists = True
                    if target_tg and action.get('Type') == 'forward' and \
                       action.get('TargetGroupArn') == target_tg.get('TargetGroupArn'):
