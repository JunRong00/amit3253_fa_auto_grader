    q4_start = (SCORED_MARKS, TOTAL_MARKS)
 
    lt_data = {}  # always defined, even when no Launch Template is found
 
    try:
        target_lt = None
        lts = ec2.describe_launch_templates()['LaunchTemplates']
        lt_candidates = [lt for lt in lts if has_token(lt.get('LaunchTemplateName', ''), name_token)]
        if lt_candidates:
            target_lt = lt_candidates[0]
        lt_name = target_lt.get('LaunchTemplateName', '') if target_lt else ""
 
        # 4.1 Launch Template Name (1m)
        lt_name_ok = bool(target_lt) and has_token(lt_name, 'lt') and has_token(lt_name, name_token)
