        # 3.10 Listener (1m HTTP, 1m port 80)
        award_points("3.10 Listener", 2, (1 if listener_proto_ok else 0) + (1 if listener_port_ok else 0))
 
        # 3.11 Default Action (1m exists, 2m correctly forwards to the TG from Q3)
        award_points("3.11 Default Action", 3, (1 if action_exists else 0) + (2 if action_forwards_correctly else 0),
